      "id": "financial_crisis_2008",
      "version": 1,
      "mode": "historical_replay",
      "input_type": "observed_quarter_average_states",
      "narrative": "Financial crisis and recession, using common quarterly-average states.",
      "rationale": "NBER dates the monthly recession December 2007-June 2009. Our study spans 2007Q4-2009Q2 average states; origin overlaps recession onset. https://www.nber.org/research/data/us-business-cycle-expansions-and-contractions",
      "origin": "2007Q4",
      "end": "2009Q2",
      "horizon_quarters": 6,
      "units": {
        "equity_price_change": "percent",
        "yield_2y_change": "basis_points",
        "yield_10y_change": "basis_points",
        "credit_spread_proxy_change": "basis_points"
      },
      "convention": "cumulative_changes",
      "reference": "historical_origin"
    },
